{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCC neutral snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "projects": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "objective",
          "status",
          "next_step",
          "blockers",
          "roadmap",
          "updated"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "blocked",
              "completed"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 4000
          },
          "objective": {
            "type": "string",
            "maxLength": 4000
          },
          "next_step": {
            "type": "string",
            "maxLength": 4000
          },
          "updated": {
            "type": "string",
            "maxLength": 4000
          },
          "blockers": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "roadmap": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      }
    }
  }
}